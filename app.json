{
  "name": "NanoURL",
  "description": "URL shortener application with unique address",
  "repository": "https://github.com/yourusername/NanoURL",
  "keywords": ["spring-boot", "react", "mysql", "url-shortener"],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    }
  },
  "addons": [
    {
      "plan": "cleardb:ignite",
      "as": "DATABASE"
    }
  ],
  "env": {
    "SPRING_PROFILES_ACTIVE": {
      "description": "Spring profile",
      "value": "prod"
    },
    "JWT_SECRET": {
      "description": "JWT secret key",
      "value": "9d8f0c6b2e5a4c1f7d9b6a8c3e4f1a0d9c7b5a3e1f6d8c2b4a9e7c5d3b1f0a2c",
      "required": true
    },
    "APP_BASE_URL": {
      "description": "Base URL for the application",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/jvm"
    }
  ],
  "scripts": {
    "postdeploy": "echo 'Deployment completed'"
  }
}
