{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "sleepApplication": false,
    "startCommand": "java -jar app.jar"
  },
  "plugins": [
    "mysql",
    "redis"
  ]
}
