# ========================================
# RENDER DEPLOYMENT ENVIRONMENT VARIABLES
# ========================================
# Copy these to Render Dashboard → Environment Variables
# Replace placeholder values with actual Render database credentials

# ========================================
# BACKEND CONFIGURATION (nanourl-backend)
# ========================================

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (PostgreSQL from Render)
# ⚠️ IMPORTANT: Get these values from Render PostgreSQL Database
# Format: jdbc:postgresql://[host]:5432/[database]?sslmode=require
DATABASE_URL=jdbc:postgresql://dpg-xxxxx.render.com:5432/nanourl_db_xxxx?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxx.render.com:5432/nanourl_db_xxxx?sslmode=require
DB_USER=nanourl_user
SPRING_DATASOURCE_USERNAME=nanourl_user
DB_PASSWORD=REPLACE_WITH_RENDER_DATABASE_PASSWORD
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_RENDER_DATABASE_PASSWORD

# Hibernate/JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=20
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_FETCH_SIZE=50
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_INSERTS=true
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_UPDATES=true

# HikariCP Connection Pool (camelCase format)
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLETIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAXLIFETIME=1200000
SPRING_DATASOURCE_HIKARI_AUTOCOMMIT=true

# JWT Configuration
# Generate secure key: openssl rand -base64 64
JWT_SECRET=render_jwt_secret_key_2026_CHANGE_THIS_TO_64_CHARACTER_RANDOM_STRING_FOR_PRODUCTION
JWT_EXPIRATION=86400000

# Application Configuration
APP_BASE_URL=https://nanourl-backend.onrender.com
SERVER_PORT=8080

# CORS Configuration
ALLOWED_ORIGINS=https://nanourl-frontend.onrender.com
CORS_ALLOWED_ORIGINS=https://nanourl-frontend.onrender.com
SPRING_WEB_CORS_ALLOWED_ORIGINS=https://nanourl-frontend.onrender.com
SPRING_WEB_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
SPRING_WEB_CORS_ALLOWED_HEADERS=*
SPRING_WEB_CORS_ALLOW_CREDENTIALS=true
SPRING_WEB_CORS_MAX_AGE=3600

# Redis Configuration (Optional - if using Render Redis)
SPRING_REDIS_HOST=red-xxxxx.render.com
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=REPLACE_WITH_RENDER_REDIS_PASSWORD

# Logging Configuration
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_NANOURL=INFO

# ========================================
# FRONTEND CONFIGURATION (nanourl-frontend)
# ========================================

# API Configuration
VITE_API_URL=https://nanourl-backend.onrender.com
VITE_API_BASE_URL=https://nanourl-backend.onrender.com

# Application Configuration
VITE_APP_NAME=NanoURL
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false

# ========================================
# DEPLOYMENT NOTES
# ========================================
# 1. Create PostgreSQL database on Render first
# 2. Copy Internal Database URL and credentials
# 3. Update DATABASE_URL and SPRING_DATASOURCE_URL with actual values
# 4. Generate secure JWT_SECRET: openssl rand -base64 64
# 5. Update ALLOWED_ORIGINS with your actual frontend URL
# 6. If using Redis, create Redis instance and update credentials
