# Backend Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nanourl_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=nanourl_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Configuration (Generate a secure random string!)
JWT_SECRET=your_256_bit_secret_key_change_this_in_production
JWT_EXPIRATION=86400000

# Application Configuration
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080

# Redis Configuration (Optional - for caching)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_NANOURL=DEBUG

# Production Settings (Set these in production environment)
# SPRING_DATASOURCE_URL=jdbc:mysql://production-host:3306/nanourl_db?useSSL=true
# APP_BASE_URL=https://your-domain.com
# LOGGING_LEVEL_ROOT=WARN
# LOGGING_LEVEL_COM_NANOURL=INFO
